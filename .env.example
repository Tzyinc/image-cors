# Choose exactly one active source. Omit SOURCE_TYPE only when exactly one URL
# below is configured; it will then be inferred.
SOURCE_TYPE=image

# Image source. Must return an image response (for example, image/jpeg or image/png).
IMAGE_SOURCE_URL=https://example.com/radar.jpg

# Website-screenshot source, used only when SOURCE_TYPE=screenshot.
SCREENSHOT_URL=https://example.com/dashboard
SCREENSHOT_VIEWPORT_WIDTH=1280
SCREENSHOT_VIEWPORT_HEIGHT=720
SCREENSHOT_FULL_PAGE=0
SCREENSHOT_WAIT_MS=1000
SCREENSHOT_TIMEOUT_MS=30000

# Optional defaults
PORT=3000
REFRESH_INTERVAL_MS=300000
